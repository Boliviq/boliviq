# Copy to .env.local for frontend-only development against the hosted Base44 backend.
# See README.md — `base44 dev` injects these automatically and .env.local is not required for it.

VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# --- Backend function secrets (set in the Base44 dashboard, NOT in this file) ---
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_PUBLISHABLE_KEY   (currently unused by the frontend — checkout uses Stripe-hosted
#                            Checkout Sessions, not client-side Stripe Elements)
# OPENAI_API_KEY
