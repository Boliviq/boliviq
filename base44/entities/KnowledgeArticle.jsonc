{
  "name": "KnowledgeArticle",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "governance",
        "vision",
        "product",
        "realestate",
        "construction",
        "crm",
        "marketplace",
        "billing",
        "ai_agents",
        "companies",
        "architecture",
        "security",
        "operations",
        "legal",
        "roadmap",
        "templates"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Markdown body of the knowledge article."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "source": {
      "type": "string",
      "description": "Origin of the article (e.g. master_kb_v1, manual)."
    }
  },
  "required": [
    "section",
    "title",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}