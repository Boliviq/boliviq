{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "credits",
        "percent"
      ],
      "default": "credits"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "redeemed",
        "expired"
      ],
      "default": "active"
    },
    "max_uses": {
      "type": "number",
      "default": 1
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "workspace_id",
    "code",
    "discount_type",
    "value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}