{
  "name": "CreditWallet",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "reserved": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "workspace_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}