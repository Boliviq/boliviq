{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "team_professional",
        "professional_ai",
        "team_professional_ai",
        "professional_ai_unlimited",
        "team_ai_unlimited"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled",
        "expired",
        "suspended"
      ],
      "default": "active"
    },
    "billing_source": {
      "type": "string",
      "enum": [
        "stripe",
        "apple",
        "google_play",
        "owner_grant",
        "promotion",
        "manual",
        "unknown"
      ],
      "default": "stripe"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_price_lookup_key": {
      "type": "string"
    },
    "current_period_end": {
      "type": "string",
      "format": "date"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "seats": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "workspace_id",
    "plan"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}