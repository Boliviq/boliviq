{
  "name": "Property",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "street_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "parcel_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "prospect",
        "under_contract",
        "owned",
        "listed",
        "sold",
        "archived"
      ],
      "default": "lead"
    },
    "pipeline_stage": {
      "type": "string"
    },
    "project_status": {
      "type": "string"
    },
    "ownership": {
      "type": "string"
    },
    "occupancy": {
      "type": "string",
      "enum": [
        "vacant",
        "owner_occupied",
        "tenant_occupied",
        "unknown"
      ],
      "default": "unknown"
    },
    "property_type": {
      "type": "string"
    },
    "deal_strategy": {
      "type": "string",
      "enum": [
        "buy_hold",
        "fix_flip",
        "wholesale",
        "wholetail",
        "brrrr",
        "new_construction",
        "land",
        "multifamily",
        "creative"
      ]
    },
    "characteristics": {
      "type": "object"
    },
    "valuation": {
      "type": "number"
    },
    "arv": {
      "type": "number"
    },
    "asking_price": {
      "type": "number"
    },
    "estimated_rehab": {
      "type": "number"
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public"],
      "default": "private",
      "description": "Public properties are discoverable by other workspaces via Deal Discovery — the Boliviq Marketplace deal-flow source."
    },
    "source": {
      "type": "string",
      "enum": ["manual", "boliviq_marketplace", "mls", "public_records", "user_import", "partner_api"],
      "default": "manual"
    },
    "source_type": {
      "type": "string",
      "enum": ["on_market", "off_market"],
      "default": "off_market"
    },
    "external_url": {
      "type": "string"
    },
    "days_on_market": {
      "type": "number"
    },
    "price_reduced": {
      "type": "boolean",
      "default": false
    },
    "distress_indicators": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tax_delinquent", "foreclosure", "auction", "vacant", "absentee_owner", "code_violation", "price_reduction", "expired_listing", "probate"]
      }
    },
    "data_confidence": {
      "type": "string",
      "enum": ["verified", "estimated"],
      "default": "verified"
    },
    "lien_encumbrance": {
      "type": "boolean",
      "default": false
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "address"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}