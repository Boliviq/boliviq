{
  "name": "DealAlert",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "full_name": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Area, city, ZIP, or keyword to match against new deals and opportunities."
    },
    "deal_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Property deal strategies to match (empty = any)."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Marketplace listing categories to match (empty = any)."
    },
    "min_price": {
      "type": "number"
    },
    "max_price": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ],
      "default": "active"
    },
    "last_sent_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "email",
    "location"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}