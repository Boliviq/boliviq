{
  "name": "Invitation",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "member",
        "finance",
        "contractor",
        "agent",
        "viewer"
      ],
      "default": "member"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ],
      "default": "pending"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "email",
    "role"
  ]
}