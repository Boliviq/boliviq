{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "contracting",
        "renovation",
        "roofing",
        "plumbing",
        "electrical",
        "hvac",
        "landscaping",
        "cleaning",
        "photography",
        "staging",
        "legal",
        "financing",
        "insurance",
        "marketing",
        "materials",
        "equipment",
        "other"
      ],
      "default": "other"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "service",
        "material",
        "equipment",
        "labor",
        "other"
      ],
      "default": "service"
    },
    "provider_name": {
      "type": "string"
    },
    "provider_contact": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "pricing_model": {
      "type": "string",
      "enum": [
        "fixed",
        "hourly",
        "per_project",
        "quote",
        "monthly"
      ],
      "default": "quote"
    },
    "price": {
      "type": "number"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "limited",
        "booked",
        "unavailable"
      ],
      "default": "available"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "workspace_id",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}